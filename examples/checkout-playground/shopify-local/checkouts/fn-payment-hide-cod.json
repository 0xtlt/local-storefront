{
  "$schema": "../schema/checkout-scenario.schema.json",
  "title": "Payment: no cash on delivery over $100",
  "description": "payment-hide-cod: 136.00 in the cart, Cash on Delivery is hidden. Remove an overshirt and it comes back.",
  "session": {
    "customer": "none",
    "cart": {
      "items": [
        {
          "variant": "OVS-M",
          "quantity": 2
        }
      ]
    }
  },
  "extensions": [
    "payment-hide-cod"
  ],
  "expect": {
    "payment_methods": {
      "excludes": [
        "cod"
      ],
      "equals": [
        "card",
        "paypal",
        "bank",
        "invoice"
      ]
    },
    "express_methods": {
      "equals": [
        "shop_pay",
        "apple_pay"
      ]
    },
    "totals": {
      "subtotal": "136.00",
      "total": "136.00"
    }
  }
}

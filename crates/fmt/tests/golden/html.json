  {
    "name": "block elements go on their own lines, inline ones stay in the text",
    "options": {},
    "source": "<div><p>Some <b>bold</b> and <a href=\"/x\">linked</a> text, long enough that it has to wrap at some point because it does not fit.</p><ul><li>one</li><li>two</li></ul></div>\n",
    "expected": "<div>\n  <p>\n    Some <b>bold</b> and <a href=\"/x\">linked</a> text, long enough that it has to wrap at some point because it does not\n    fit.\n  </p>\n  <ul>\n    <li>one</li>\n    <li>two</li>\n  </ul>\n</div>\n",
    "again": "<div>\n  <p>\n    Some <b>bold</b> and <a href=\"/x\">linked</a> text, long enough that it has to wrap at some point because it does not\n    fit.\n  </p>\n  <ul>\n    <li>one</li>\n    <li>two</li>\n  </ul>\n</div>\n"
  },
  {
    "name": "attributes break one per line when they do not fit",
    "options": {},
    "source": "<img src=\"{{ image | image_url: width: 400 }}\" alt=\"{{ image.alt | escape }}\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"card__image\">\n<a   class=\"a\"   href=\"/x\" >x</a>\n<input type=\"checkbox\" checked disabled>\n<br/><hr><custom-element some-attribute></custom-element>\n",
    "expected": "<img\n  src=\"{{ image | image_url: width: 400 }}\"\n  alt=\"{{ image.alt | escape }}\"\n  width=\"400\"\n  height=\"300\"\n  loading=\"lazy\"\n  class=\"card__image\"\n>\n<a class=\"a\" href=\"/x\">x</a>\n<input type=\"checkbox\" checked disabled>\n<br />\n<hr>\n<custom-element some-attribute></custom-element>\n",
    "again": "<img\n  src=\"{{ image | image_url: width: 400 }}\"\n  alt=\"{{ image.alt | escape }}\"\n  width=\"400\"\n  height=\"300\"\n  loading=\"lazy\"\n  class=\"card__image\"\n>\n<a class=\"a\" href=\"/x\">x</a>\n<input type=\"checkbox\" checked disabled>\n<br />\n<hr>\n<custom-element some-attribute></custom-element>\n"
  },
  {
    "name": "attributes that were on several lines stay on several lines",
    "options": {},
    "source": "<div\n  class=\"a\" id=\"b\">x</div>\n",
    "expected": "<div\n  class=\"a\"\n  id=\"b\"\n>\n  x\n</div>\n",
    "again": "<div\n  class=\"a\"\n  id=\"b\"\n>\n  x\n</div>\n"
  },
  {
    "name": "the value of an attribute is kept as written",
    "options": {},
    "source": "<div class=\"a  {{ b }}   c\" data-x='{\"a\": 1}' style=\"color: red;margin:0\" data-y=unquoted {{ block.shopify_attributes }}></div>\n<div class=\"\n      a\n   b\n      {% if c %}d{% endif %}\n\"></div>\n",
    "expected": "<div\n  class=\"a  {{ b }}   c\"\n  data-x='{\"a\": 1}'\n  style=\"color: red;margin:0\"\n  data-y=\"unquoted\"\n  {{ block.shopify_attributes }}\n></div>\n<div\n  class=\"\n       a\n    b\n       {% if c %}d{% endif %}\n  \"\n></div>\n",
    "again": "<div\n  class=\"a  {{ b }}   c\"\n  data-x='{\"a\": 1}'\n  style=\"color: red;margin:0\"\n  data-y=\"unquoted\"\n  {{ block.shopify_attributes }}\n></div>\n<div\n  class=\"\n       a\n    b\n       {% if c %}d{% endif %}\n  \"\n></div>\n"
  },

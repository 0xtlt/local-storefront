<h1>{{ shop.name }}</h1>
{%- if shop.password_message != blank %}
<p class="message">{{ shop.password_message }}</p>
{%- endif %}
{% form 'storefront_password' %}
  {%- if form.errors %}
  <p class="error">{{ form.errors.messages['form'] }}</p>
  {%- endif %}
  <input type="password" name="password">
  <button>Enter</button>
{% endform %}

{%- assign variant = product.selected_or_first_available_variant -%}
<h1>{{ product.title }}</h1>
<p class="price">{% render 'price', price: variant.price, compare_at_price: variant.compare_at_price %}</p>
{{ product.featured_image | image_url: width: 400 | image_tag: loading: 'eager', class: 'main' }}
{% form 'product', product, class: 'buy', data-kind: 'main' %}
<select name="id">
{%- for v in product.variants %}
<option value="{{ v.id }}"{% if v == variant %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title }}</option>
{%- endfor %}
</select>
{% endform %}
<ul>
{%- for option in product.options_with_values %}
<li>{{ option.name }}: {% for value in option.values %}{{ value }}{% if value.selected %}*{% endif %}{% unless value.available %}!{% endunless %}{% unless forloop.last %}, {% endunless %}{% endfor %}</li>
{%- endfor %}
</ul>
<script type="application/json">{{ variant | json }}</script>
{% schema %}
{ "name": "Product", "tag": "section" }
{% endschema %}
